  %% Relationships
  User ||--o| EmployeeProfile : "has"
  User ||--o| CustomerProfile : "has"
  User ||--o| DeliveryProfile : "has"
  Role ||--o{ User : "assigned to"
  Role ||--o{ RolePermission : "has"
  Permission ||--o{ RolePermission : "belongs to"
  User ||--o{ FoodOrder : "places"
  FoodOrder ||--o{ OrderItem : "contains"
  FoodOrder ||--o{ OrderStatusHistory : "has"
  FoodOrder ||--o| OrderRating : "receives"
  FoodOrder ||--o| OrderDispatch : "has"
  FoodOrder ||--o| OrderPayment : "has"
  User ||--o{ KitchenTask : "assigned to/by"
  User ||--o{ Payment : "makes"
  User ||--o{ Refund : "receives"
  User ||--o{ FoodNotification : "receives"
  User ||--o{ BroadcastNotification : "receives"
  User ||--o{ FoodUserWallet : "owns"
