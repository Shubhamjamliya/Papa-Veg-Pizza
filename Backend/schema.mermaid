erDiagram
  AuditLog {
    mongoose userId
    String role
    String module
    String action
    Object oldValue
    Object newValue
    String ipAddress
    String device
    Date createdAt
    Date updatedAt
  }
  Permission {
    String module
    String action
    String description
    Date createdAt
    Date updatedAt
  }
  Role {
    String name
    String code
    String description
    Boolean isActive
    Date createdAt
    Date updatedAt
    Number priority
  }
  RolePermission {
    mongoose roleId
    mongoose permissionId
    Date createdAt
    Date updatedAt
  }
  FoodNotification {
    mongoose userId
    String title
    String message
    String link
    String category
    String source
